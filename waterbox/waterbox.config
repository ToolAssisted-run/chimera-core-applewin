    {
      "id": "DISK2.rom",
      "display": "Disk II controller ROM",
      "description": "The 256-byte boot PROM (P5) of the Disk II controller card in slot 6: what reads track 0 and starts a disk. Every machine here has the card, so it is always needed. Apple's, and yours to supply. AppleWin's source tree carries it as resource/DISK2.rom.",
      "size": 256,
      "sha1": "D4181C9F046AAFC3FB326B381BAAC809D9E38D16",
      "name": "DISK2.rom"
    },
    {
      "id": "SSC.rom",
      "display": "Super Serial Card firmware",
      "description": "The 2 KB firmware of Apple's Super Serial Card, which AppleWin puts in slot 2 by default; needed while the serial setting keeps the card. Apple's, and yours to supply. AppleWin's source tree carries it as resource/SSC.rom.",
      "size": 2048,
      "sha1": "6DAB633470C6BC4CB3E81D09FDA46597CAF8EE57",
      "name": "SSC.rom",
      "requiredWhen": {
        "setting": "serial",
        "in": [
          "slot2"
        ]
      }
    },
    {
      "id": "Parallel.rom",
      "display": "Parallel printer card firmware",
      "description": "The 256-byte firmware of the parallel printer interface AppleWin puts in slot 1 by default; needed while the printer setting keeps the card. Apple's, and yours to supply. AppleWin's source tree carries it as resource/Parallel.rom.",
      "size": 256,
      "sha1": "C75C751589CBCC1AD4AB4F63676AF7ABADD86F5B",
      "name": "Parallel.rom",
      "requiredWhen": {
        "setting": "printer",
        "in": [
          "slot1"
        ]
      }
    }
  ]
