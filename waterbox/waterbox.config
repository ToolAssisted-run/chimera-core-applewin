    {
      "id": "DISK2.rom",
      "display": "Disk II controller ROM",
      "description": "The boot ROM of the Disk II controller card in slot 6 (256 bytes, the chip called P5). It reads the first track and starts a disk. Every machine here has the card, so the file is always needed. It is Apple's and you have to supply it. AppleWin's source has it as resource/DISK2.rom.",
      "size": 256,
      "sha1": "D4181C9F046AAFC3FB326B381BAAC809D9E38D16",
      "name": "DISK2.rom"
    },
    {
      "id": "SSC.rom",
      "display": "Super Serial Card firmware",
      "description": "The firmware of Apple's Super Serial Card (2 KB), which AppleWin puts in slot 2 by default. It is needed as long as the Serial card setting keeps the card. It is Apple's and you have to supply it. AppleWin's source has it as resource/SSC.rom.",
      "size": 2048,
      "sha1": "6DAB633470C6BC4CB3E81D09FDA46597CAF8EE57",
      "name": "SSC.rom",
      "requiredWhen": {
        "setting": "serial",
        "in": [
          "slot2"
        ]
      }
    },
    {
      "id": "Parallel.rom",
      "display": "Parallel printer card firmware",
      "description": "The firmware of the parallel printer card (256 bytes), which AppleWin puts in slot 1 by default. It is needed as long as the Printer card setting keeps the card. It is Apple's and you have to supply it. AppleWin's source has it as resource/Parallel.rom.",
      "size": 256,
      "sha1": "C75C751589CBCC1AD4AB4F63676AF7ABADD86F5B",
      "name": "Parallel.rom",
      "requiredWhen": {
        "setting": "printer",
        "in": [
          "slot1"
        ]
      }
    }
  ]
}
