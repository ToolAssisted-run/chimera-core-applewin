  "settings": [
    {
      "name": "model",
      "display": "Apple II Model",
      "type": "enum",
      "options": [
        "apple2eEnhanced",
        "apple2e",
        "apple2plus",
        "apple2",
        "apple2jplus",
        "pravets82",
        "pravets8m",
        "pravets8a",
        "tk3000",
        "base64a"
      ],
      "default": "apple2eEnhanced",
      "description": "Which Apple II this is. The choices are the enhanced //e (with a 65C02 processor, the machine most software expects), the original //e, the ][+ and the ][ (6502 processor, no lowercase letters, no 80 columns), the Japanese ][ J-Plus, and the clones AppleWin knows. The model decides the ROM, the processor and the keyboard."
    },
    {
      "name": "video",
      "display": "Monitor",
      "type": "enum",
      "options": [
        "colorTv",
        "colorMonitor",
        "colorIdealized",
        "rgbCard",
        "monoTv",
        "monoAmber",
        "monoGreen",
        "monoWhite"
      ],
      "default": "colorTv",
      "description": "How the picture is drawn: as on a colour television (with NTSC colour effects, AppleWin's default), a colour monitor, idealised colour, an RGB card or a monochrome monitor. A program runs the same with any of them. The picture a movie shows is different, so the setting is recorded with the machine."
    },
    {
      "name": "halfScanlines",
      "display": "Half Scanlines",
      "type": "bool",
      "default": false,
      "description": "Draws every second line dark, to look like a picture tube. AppleWin has this on by default. It is off here, because Chimera scales a full picture better."
    },
    {
      "name": "refreshRate",
      "display": "Refresh Rate",
      "type": "enum",
      "options": [
        "60",
        "50"
      ],
      "default": "60",
      "description": "60 Hz is an NTSC Apple (17030 processor cycles per frame, 1.0205 MHz). 50 Hz is a PAL Apple (20280 cycles, 1.0156 MHz). It changes the frame rate and the machine's timing."
    },
    {
      "name": "joystick1",
      "display": "Joystick 1",
      "type": "bool",
      "default": true,
      "description": "A joystick in the game port (the P1 axes and buttons). With none plugged in, the paddle inputs read as not connected, which some programs need."
    },
    {
      "name": "joystick2",
      "display": "Joystick 2",
      "type": "bool",
      "default": false,
      "description": "A second joystick (the P2 axes and button). Plugging it in changes how the buttons are shared between the joysticks, as on the real machine."
    },
    {
      "name": "mockingboard",
      "display": "Mockingboard",
      "type": "enum",
      "options": [
        "slot4",
        "slot4and5",
        "slot5",
        "none"
      ],
      "default": "slot4",
      "description": "A Mockingboard sound card in slot 4 (AppleWin's default), in slots 4 and 5, in slot 5 only, or none."
    },
    {
      "name": "printer",
      "display": "Printer card",
      "type": "enum",
      "options": [
        "slot1",
        "none"
      ],
      "default": "slot1",
      "description": "A parallel printer card in slot 1, as AppleWin has by default, or an empty slot. The card's firmware is the Parallel.rom file the core asks for. It is part of the machine, because a program that checks the slot sees the difference."
    },
    {
      "name": "serial",
      "display": "Serial card",
      "type": "enum",
      "options": [
        "slot2",
        "none"
      ],
      "default": "slot2",
      "description": "A Super Serial Card in slot 2, as AppleWin has by default, or an empty slot. The card's firmware is the SSC.rom file the core asks for. It is part of the machine, because a program that checks the slot sees the difference."
    },
    {
      "name": "enhanceDiskSpeed",
      "display": "Enhanced Disk Speed",
      "type": "bool",
      "default": true,
      "description": "On (AppleWin's default), the Disk II drive reads at full speed and not at the speed of a real drive. Off gives the real drive's timing. Either way the timing is the same on every computer."
    },
    {
      "name": "memoryPattern",
      "display": "Power-on Memory",
      "type": "enum",
      "options": [
        "ffff0000",
        "zero",
        "random",
        "ff00FullPage",
        "00ffHalfPage",
        "ff00HalfPage",
        "pageAddressLow",
        "pageAddressHigh"
      ],
      "default": "ffff0000",
      "description": "What the memory holds when the machine is switched on. A real Apple's memory holds a pattern that depends on its memory chips. AppleWin's default alternates FF FF 00 00. 'random' takes its values from the Random Seed, so they are the same every time."
    },
    {
      "name": "randomSeed",
      "display": "Random Seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 2147483647,
      "description": "The starting number of the random generator that AppleWin's disk emulation uses for the noise a Disk II drive reads between valid data. A movie records the number it ran with."
    },
    {
      "name": "speakerVolume",
      "display": "Speaker Volume",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "description": "The volume of the Apple's speaker, in percent. It changes the sound output only."
    },
    {
      "name": "mockingboardVolume",
      "display": "Mockingboard Volume",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "description": "The volume of the Mockingboard, in percent. It changes the sound output only."
    }
  ],
  "firmware": [
    {
      "id": "Apple2e_Enhanced.rom",
      "display": "Enhanced Apple IIe ROM",
      "description": "The system ROM of the enhanced Apple IIe, the 65C02 machine of 1985 (16 KB). It holds the monitor program, Applesoft BASIC and the 80-column firmware. It is Apple's and you have to supply it. AppleWin's source has it as resource/Apple2e_Enhanced.rom.",
      "size": 16384,
      "sha1": "B8EA90ABE135A0031065E01697C4A3A20D51198B",
      "name": "Apple2e_Enhanced.rom",
      "requiredWhen": {
        "setting": "model",
        "in": [
          "apple2eEnhanced"
        ]
      }
    },
    {
      "id": "Apple2e.rom",
      "display": "Apple IIe ROM",
      "description": "The system ROM of the original (unenhanced) Apple IIe (16 KB). It is Apple's and you have to supply it. AppleWin's source has it as resource/Apple2e.rom.",
      "size": 16384,
      "sha1": "61FA9254628E5BB7236FB474006116D67684D747",
      "name": "Apple2e.rom",
      "requiredWhen": {
        "setting": "model",
        "in": [
          "apple2e"
        ]
      }
    },
    {
      "id": "Apple2_Plus.rom",
      "display": "Apple II Plus ROM",
      "description": "The ROM of the Apple II Plus (12 KB). It holds the autostart monitor and Applesoft BASIC. It is Apple's and you have to supply it. AppleWin's source has it as resource/Apple2_Plus.rom.",
      "size": 12288,
      "sha1": "33A24F5489BA9195B44BE77D9AFB2252594CB5C7",
      "name": "Apple2_Plus.rom",
      "requiredWhen": {
