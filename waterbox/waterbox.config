  "settings": [
    {
      "name": "model",
      "display": "setting.model",
      "type": "enum",
      "options": [
        "apple2eEnhanced",
        "apple2e",
        "apple2plus",
        "apple2",
        "apple2jplus",
        "pravets82",
        "pravets8m",
        "pravets8a",
        "tk3000",
        "base64a"
      ],
      "default": "apple2eEnhanced",
      "description": "setting.model.about"
    },
    {
      "name": "video",
      "display": "setting.video",
      "type": "enum",
      "options": [
        "colorTv",
        "colorMonitor",
        "colorIdealized",
        "rgbCard",
        "monoTv",
        "monoAmber",
        "monoGreen",
        "monoWhite"
      ],
      "default": "colorTv",
      "description": "setting.video.about"
    },
    {
      "name": "halfScanlines",
      "display": "setting.halfscanlines",
      "type": "bool",
      "default": false,
      "description": "setting.halfscanlines.about"
    },
    {
      "name": "refreshRate",
      "display": "setting.refreshrate",
      "type": "enum",
      "options": [
        "60",
        "50"
      ],
      "default": "60",
      "description": "setting.refreshrate.about"
    },
    {
      "name": "joystick1",
      "display": "setting.joystick1",
      "type": "bool",
      "default": true,
      "description": "setting.joystick1.about"
    },
    {
      "name": "joystick2",
      "display": "setting.joystick2",
      "type": "bool",
      "default": false,
      "description": "setting.joystick2.about"
    },
    {
      "name": "mockingboard",
      "display": "setting.mockingboard",
      "type": "enum",
      "options": [
        "slot4",
        "slot4and5",
        "slot5",
        "none"
      ],
      "default": "slot4",
      "description": "setting.mockingboard.about"
    },
    {
      "name": "printer",
      "display": "setting.printer",
      "type": "enum",
      "options": [
        "slot1",
        "none"
      ],
      "default": "slot1",
      "description": "setting.printer.about"
    },
    {
      "name": "serial",
      "display": "setting.serial",
      "type": "enum",
      "options": [
        "slot2",
        "none"
      ],
      "default": "slot2",
      "description": "setting.serial.about"
    },
    {
      "name": "enhanceDiskSpeed",
      "display": "setting.enhancediskspeed",
      "type": "bool",
      "default": true,
      "description": "setting.enhancediskspeed.about"
    },
    {
      "name": "memoryPattern",
      "display": "setting.memorypattern",
      "type": "enum",
      "options": [
        "ffff0000",
        "zero",
        "random",
        "ff00FullPage",
        "00ffHalfPage",
        "ff00HalfPage",
        "pageAddressLow",
        "pageAddressHigh"
      ],
      "default": "ffff0000",
      "description": "setting.memorypattern.about"
    },
    {
      "name": "randomSeed",
      "display": "setting.randomseed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 2147483647,
      "description": "setting.randomseed.about"
    },
    {
      "name": "speakerVolume",
      "display": "setting.speakervolume",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "description": "setting.speakervolume.about"
    },
    {
      "name": "mockingboardVolume",
      "display": "setting.mockingboardvolume",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "description": "setting.mockingboardvolume.about"
    }
  ],
