{
  "coreName": "AppleWin",
  "systemId": "AppleII",
  "author": "The AppleWin team; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-applewin",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    8,
    8,
    32,
    128
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The Apple itself is 128K; the room is for AppleWin's own machinery (the NTSC renderer's tables, a RamWorks card of up to 8 MB, the debugger's symbol tables) and the disk-image write overlay, which grows with what the machine writes.",
  "video": {
    "_comment": "AppleWin's NTSC renderer draws the Apple's 40/80-column text and 280/560-wide graphics into a 560x384 picture (every scanline doubled). The 4:3 monitor is the virtual size.",
    "width": 560,
    "height": 384,
    "virtualWidth": 560,
    "virtualHeight": 420,
    "vsyncNumerator": 1640625,
    "vsyncDenominator": 27379,
    "_vsync_note": "The 6502 clock over the cycles in a frame: (14318181.81 * 65/912) / 17030 = 59.9227 Hz, exact as a fraction. A machine set to 50 Hz reports its own (see GetVsyncNumerator).",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 4096,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".dsk": "AppleII",
    ".do": "AppleII",
    ".po": "AppleII",
    ".nib": "AppleII",
    ".woz": "AppleII",
    ".2mg": "AppleII",
    ".hdv": "AppleII"
  },
  "input": {
    "name": "Apple II Keyboard and Joysticks",
    "_comment": "The IIe keyboard key by key (Reset is the Ctrl-Reset of the keyboard, Open and Solid Apple are the two Apple keys, which are also the joystick's pushbuttons), then the joystick pushbuttons, then the disk swaps. A wide controller: every button rides SetButton.",
    "buttons": [
      "Reset",
      "Key Escape",
      "Key 1",
      "Key 2",
      "Key 3",
      "Key 4",
      "Key 5",
      "Key 6",
      "Key 7",
      "Key 8",
      "Key 9",
      "Key 0",
      "Key Minus",
      "Key Equals",
      "Key Delete",
      "Key Tab",
      "Key Q",
      "Key W",
      "Key E",
      "Key R",
      "Key T",
      "Key Y",
      "Key U",
      "Key I",
      "Key O",
      "Key P",
      "Key LeftBracket",
      "Key RightBracket",
      "Key Backslash",
      "Key Control",
      "Key A",
      "Key S",
      "Key D",
      "Key F",
      "Key G",
      "Key H",
      "Key J",
      "Key K",
      "Key L",
      "Key Semicolon",
      "Key Quote",
      "Key Return",
      "Key Shift",
      "Key Z",
      "Key X",
      "Key C",
      "Key V",
      "Key B",
      "Key N",
      "Key M",
      "Key Comma",
      "Key Period",
      "Key Slash",
      "Key CapsLock",
      "Key Open Apple",
      "Key Solid Apple",
      "Key Space",
      "Key Grave",
      "Key Left",
      "Key Right",
      "Key Up",
      "Key Down",
      "P1 Button 1",
      "P1 Button 2",
      "P2 Button 1",
      "Next Disk 1",
      "Next Disk 2"
    ],
    "axes": [
      {
        "name": "P1 Joystick X",
        "min": 0,
        "max": 255,
        "neutral": 127
      },
      {
        "name": "P1 Joystick Y",
        "min": 0,
        "max": 255,
        "neutral": 127
      },
      {
        "name": "P2 Joystick X",
        "min": 0,
        "max": 255,
        "neutral": 127
      },
      {
        "name": "P2 Joystick Y",
        "min": 0,
        "max": 255,
        "neutral": 127
      }
    ]
  },
  "settings": [
    {
      "name": "model",
      "display": "Apple II Model",
      "type": "enum",
      "options": [
        "apple2eEnhanced",
        "apple2e",
        "apple2plus",
        "apple2",
        "apple2jplus",
        "pravets82",
        "pravets8m",
        "pravets8a",
        "tk3000",
        "base64a"
      ],
      "default": "apple2eEnhanced",
      "description": "Which Apple II this is: the enhanced //e (65C02, the machine most software expects), the original //e, the ][+ or the ][ (6502, no lowercase, no 80 columns), the Japanese ][ J-Plus, or one of the clones AppleWin knows. It picks the ROM, the CPU and the keyboard."
    },
    {
      "name": "video",
      "display": "Monitor",
      "type": "enum",
      "options": [
        "colorTv",
        "colorMonitor",
        "colorIdealized",
        "rgbCard",
        "monoTv",
        "monoAmber",
        "monoGreen",
        "monoWhite"
      ],
      "default": "colorTv",
      "description": "How the picture is rendered: a colour TV (NTSC artefacts, AppleWin's default), a colour monitor, idealised colour, an RGB card, or a monochrome monitor. Part of the machine because a program can read what it drew back through the video scanner only in the same way regardless - but the picture a movie is judged by changes."
    },
    {
      "name": "halfScanlines",
      "display": "Half Scanlines",
      "type": "bool",
      "default": false,
      "description": "Draw every other line dark, as AppleWin does by default for a CRT look. Off here: a full picture is what a frontend can scale."
    },
    {
      "name": "refreshRate",
      "display": "Refresh Rate",
      "type": "enum",
      "options": [
        "60",
        "50"
      ],
      "default": "60",
      "description": "60 Hz is an NTSC Apple (17030 cycles per frame, 1.0205 MHz); 50 Hz a PAL one (20280 cycles, 1.0156 MHz). It changes the frame rate and the machine's timing."
    },
    {
      "name": "joystick1",
      "display": "Joystick 1",
      "type": "bool",
      "default": true,
      "description": "A joystick in the game port (the P1 axes and buttons). Without one the paddle inputs read as open, which some programs need."
    },
    {
      "name": "joystick2",
      "display": "Joystick 2",
      "type": "bool",
      "default": false,
      "description": "A second joystick (the P2 axes and button). Plugging it in changes how the pushbuttons are shared, as on the real machine."
    },
    {
      "name": "mockingboard",
      "display": "Mockingboard",
      "type": "enum",
      "options": [
        "slot4",
        "slot4and5",
        "slot5",
        "none"
      ],
      "default": "slot4",
      "description": "A Mockingboard sound card in slot 4 (AppleWin's default), in both 4 and 5, in 5 only, or none."
    },
    {
      "name": "enhanceDiskSpeed",
      "display": "Enhanced Disk Speed",
      "type": "bool",
      "default": true,
      "description": "AppleWin's default: the Disk II reads at full speed rather than at a real drive's. Off is faithful timing, and the same timing on every host either way."
    },
    {
      "name": "memoryPattern",
      "display": "Power-on Memory",
      "type": "enum",
      "options": [
        "ffff0000",
        "zero",
        "random",
        "ff00FullPage",
        "00ffHalfPage",
        "ff00HalfPage",
        "pageAddressLow",
        "pageAddressHigh"
      ],
      "default": "ffff0000",
      "description": "What RAM holds at power-on. A real Apple's is a pattern of its DRAM; AppleWin's default alternates FF FF 00 00. 'random' uses the pinned generator, so it is the same random every time."
    },
    {
      "name": "randomSeed",
      "display": "Random Seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 2147483647,
      "description": "The seed of the one generator AppleWin's disk emulation draws its noise from (the bits a Disk II reads between nibbles). A movie records the number it ran with."
    },
    {
      "name": "speakerVolume",
      "display": "Speaker Volume",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "description": "The Apple's speaker in the mix, percent. Output only."
    },
    {
      "name": "mockingboardVolume",
      "display": "Mockingboard Volume",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "description": "The Mockingboard in the mix, percent. Output only."
    }
  ],
  "firmware": []
}
