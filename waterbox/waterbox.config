{
  "coreName": "AppleWin",
  "systemId": "AppleII",
  "systemNames": {
    "AppleII": "Apple II"
  },
  "author": "The AppleWin team; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-applewin",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    8,
    8,
    32,
    128
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The Apple itself is 128K; the room is for AppleWin's own machinery (the NTSC renderer's tables, a RamWorks card of up to 8 MB, the debugger's symbol tables) and the disk-image write overlay, which grows with what the machine writes.",
  "video": {
    "_comment": "AppleWin's NTSC renderer draws the Apple's 40/80-column text and 280/560-wide graphics into a 560x384 picture (every scanline doubled). The 4:3 monitor is the virtual size.",
    "width": 560,
    "height": 384,
    "virtualWidth": 560,
    "virtualHeight": 420,
    "vsyncNumerator": 1640625,
    "vsyncDenominator": 27379,
    "_vsync_note": "The 6502 clock over the cycles in a frame: (14318181.81 * 65/912) / 17030 = 59.9227 Hz, exact as a fraction. A machine set to 50 Hz reports its own (see GetVsyncNumerator).",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 4096,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".dsk": "AppleII",
    ".do": "AppleII",
    ".po": "AppleII",
    ".nib": "AppleII",
    ".woz": "AppleII",
    ".2mg": "AppleII",
    ".hdv": "AppleII"
  },
  "input": {
    "name": "Apple II Keyboard and Joysticks",
    "_comment": "The IIe keyboard key by key (Reset is the Ctrl-Reset of the keyboard, Open and Solid Apple are the two Apple keys, which are also the joystick's pushbuttons), then the joystick pushbuttons, then the disk swaps. A wide controller: every button rides SetButton.",
    "buttons": [
      "Reset",
      "Key Escape",
      "Key 1",
